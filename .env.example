# Conversion photo → line art (API Gemini)
# Copiez ce fichier en .env.local et renseignez votre clé Google AI Studio.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optionnel : surcharger le modèle d'image utilisé
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Connexion Google (capture de contact dans la modal) — optionnel.
# Client ID OAuth « Web » créé dans Google Cloud Console.
# Sans cette valeur, seule la saisie d'email est proposée.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Destination des leads capturés — optionnel.
# Si défini, chaque contact est envoyé en POST JSON à cette URL
# (CRM, Zapier, Make, Notion…). Sinon, les leads sont journalisés côté serveur.
LEAD_WEBHOOK_URL=
