# Conversion photo → line art (API Gemini)
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optionnel : surcharger le modèle d'image
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Connexion Google (capture de contact dans la modal) — optionnel.
# Client ID OAuth « Web » créé dans Google Cloud Console.
# Sans cette valeur, seule la saisie d'email est proposée.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Leads → Notion
# Jeton d'intégration interne Notion + id de la base « Leads ».
# Voir le README pour le schéma de base attendu.
NOTION_TOKEN=
NOTION_LEADS_DATABASE_ID=
# Repli optionnel : si défini (et Notion absent), les leads sont envoyés ici.
LEAD_WEBHOOK_URL=

# Paiement → Stripe
# Clé secrète Stripe (sk_test_… en développement).
STRIPE_SECRET_KEY=

# URL publique du site (pour les redirections Stripe). Optionnel en local.
# NEXT_PUBLIC_SITE_URL=https://jewel-memories.com
