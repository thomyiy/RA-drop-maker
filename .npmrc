node-linker=hoisted

# Libs @thomyiy/* publiées sur GitHub Packages (scope = compte propriétaire).
# En workspace, pnpm résout via le monorepo ; ces lignes servent à la publication
# et à la consommation depuis un repo de drop séparé.
@thomyiy:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}
