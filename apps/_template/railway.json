{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm install --frozen-lockfile && pnpm --filter drop-template build"
  },
  "deploy": {
    "startCommand": "pnpm --filter drop-template start",
    "restartPolicyType": "ON_FAILURE"
  }
}
