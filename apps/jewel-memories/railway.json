{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm install --frozen-lockfile && pnpm --filter jewel-memories build"
  },
  "deploy": {
    "startCommand": "pnpm --filter jewel-memories start",
    "restartPolicyType": "ON_FAILURE"
  }
}
